# Base URL of the Go backend API.
VITE_API_BASE_URL=http://localhost:8080
VITE_AUTH_LOGIN_PATH=/auth/login
VITE_AUTH_REGISTER_PATH=/auth/register
VITE_ENABLE_MOCK_AUTH=false

# Google sign-in is optional. Use the same client ID in backend GOOGLE_CLIENT_ID.
VITE_GOOGLE_AUTH_ENABLED=false
VITE_GOOGLE_CLIENT_ID=

# Sentry error reporting. Empty disables it entirely (no default/shared DSN).
VITE_SENTRY_DSN=

# Market data is proxied by the Go backend. Do not put Twelve Data keys here.
