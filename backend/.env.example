# Copy to .env and adjust. The app also runs with these defaults if no env vars
# are set — but you MUST change JWT_SECRET in production.
#
# The backend loads env files from the current directory, ../.env, and
# backend/.env so both of these work:
#   cd backend && go run ./cmd/api
#   go run ./backend/cmd/api
# Set FINANCE_APP_ENV_FILE=/path/to/file to load a different local file first.

APP_ENV=development
PORT=8080
# Private diagnostics listener. Loopback is the safe default. Container
# platforms may bind 0.0.0.0:9090 only with an operations-only network policy.
OPERATIONS_ADDR=127.0.0.1:9090

# JWT_SECRET MUST be set to a real, random value when APP_ENV=production — the
# server refuses to start in production with the default value below.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRY_HOURS=4
PASSWORD_REGISTRATION_ENABLED=true
PUBLIC_APP_URL=http://localhost:5137
EMAIL_SENDER=development
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h
REAUTHENTICATION_TTL=5m
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Comma-separated allow-list of origins permitted to call this API cross-
# origin, e.g. https://app.example.com,https://www.example.com. Leave unset in
# development for the permissive "*" default (the embedded test UI and local
# frontend need this); when APP_ENV=production this MUST be set, or the API
# sends no CORS headers at all and browsers block every cross-origin request.
CORS_ALLOWED_ORIGINS=

# Comma-separated CIDRs for ingress/load-balancer peers allowed to set client
# IP forwarding headers. Leave empty when the API is reached directly. Do not
# use broad public ranges; configure only the proxy networks you control.
TRUSTED_PROXY_CIDRS=

# OAuth sign-in. Disabled by default; do not commit real secrets.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=

# Storage: "memory" (default, no infrastructure needed) or "postgres".
# For durable local mode, start Postgres with Docker Compose and set
# STORAGE_PROVIDER=postgres.
STORAGE_PROVIDER=memory
DATABASE_URL=postgres://postgres:postgres@localhost:5432/finance_app?sslmode=disable

# Redis (leaderboard cache + price cache). Leave empty to disable Redis.
REDIS_URL=

# Price source: "mock" (deterministic, offline), "twelvedata" (optional real
# USA stock/ETF data), or "yahoo" (prototype only).
PRICE_PROVIDER=mock
# Production refuses mock prices unless this explicit switch is true AND
# BENCHMARK_AWARD_MODE=demo. Leave false for real production data.
DEMO_MODE_ENABLED=false
PRICE_CACHE_TTL_SECONDS=300

# Prototype 3A real market data. Disabled by default to protect local tests and
# Twelve Data free-tier quotas. Frontend never calls Twelve Data directly.
ENABLE_REAL_MARKET_DATA=false
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
QUOTE_REFRESH_INTERVAL_SECONDS=600
QUOTE_CACHE_TTL_SECONDS=600
TWELVE_DATA_MAX_REQUESTS_PER_MINUTE=6
TWELVE_DATA_DAILY_REQUEST_BUDGET=500
TWELVE_DATA_REQUEST_TIMEOUT_SECONDS=10
ENABLE_QUOTE_REFRESH_WORKER=false
QUOTE_STALE_AFTER_SECONDS=900
QUOTE_ALLOW_STALE_ON_PROVIDER_ERROR=true

BASE_CURRENCY=USD

# Background jobs (leaderboard cache refresh and optional competition upkeep).
ENABLE_BACKGROUND_WORKERS=true
# Enable on exactly one designated application instance during controlled
# rollout. This gates competition lifecycle, baseline, ranking, finalization,
# achievement projection, and legacy sprint maintenance without disabling
# unrelated background jobs.
ENABLE_COMPETITION_WORKER=false
LEADERBOARD_REFRESH_INTERVAL_SECONDS=60
# Mandatory PostgreSQL outbox/projector readiness thresholds.
OUTBOX_READINESS_MAX_PENDING=1000
OUTBOX_READINESS_MAX_AGE=15m

# Canonical ranked-performance history used by timeframe leaderboards and
# benchmark achievements.
RANKED_SNAPSHOT_INTERVAL=4h
RANKED_INTRADAY_RETENTION_DAYS=120
RANKED_BOUNDARY_TOLERANCE=36h
RANKED_END_FRESHNESS=8h
RANKED_ACTIVE_COVERAGE_THRESHOLD=0.90

# Permanent benchmark-award policy, independent of the price provider:
#   disabled      - show catalogue/progress, never write awards
#   demo          - synthetic/mock data may create clearly-marked demo awards
#   verified_only - only real, adjusted/total-return data creates verified
#                   awards; synthetic/raw/stale data fails closed (default)
BENCHMARK_AWARD_MODE=verified_only

# Automatic corporate-action pipeline. Users never enter corporate actions;
# the worker ingests provider events and applies routine transformations
# (splits, ticker changes) automatically. The manual dev provider needs no keys.
CORPORATE_ACTIONS_ENABLED=false
CORPORATE_ACTION_PRIMARY_PROVIDER=manual_dev
CORPORATE_ACTION_FALLBACK_PROVIDER=
CORPORATE_ACTION_REFERENCE_PROVIDER=twelve_data
CORPORATE_ACTION_POLL_INTERVAL=24h
CORPORATE_ACTION_LOOKBACK=7d
CORPORATE_ACTION_RETRY_INTERVAL=1h

# Automatic provider-driven income pipeline. Routine income (dividends, ETF/fund
# distributions, bond coupons, return of capital, stock dividends) is detected
# and credited automatically; users never enter ordinary income. The manual dev
# provider needs no API keys. Do NOT commit real API keys.
INCOME_TRACKING_ENABLED=false
INCOME_PRIMARY_PROVIDER=manual_dev
INCOME_FALLBACK_PROVIDER=
INCOME_EVENT_POLL_INTERVAL=24h
INCOME_EVENT_LOOKBACK=2880h
INCOME_APPLICATION_INTERVAL=1h
INCOME_RETRY_INTERVAL=1h
# Default income handling: hold as cash (false) or reinvest when possible (true).
INCOME_REINVEST_BY_DEFAULT=false
# Credit expected gross (marked estimated) when no actual broker data exists.
INCOME_USE_ESTIMATED_GROSS=true
# Optional withholding estimate (fraction, e.g. 0.15). Tracking, not tax advice.
INCOME_WITHHOLDING_DEFAULT_RATE=0

# --- External event-data providers -------------------------------------------
# The *_PRIMARY_PROVIDER settings above now actually select which adapter is
# built at startup:
#   manual_dev  offline, deterministic, no API keys — the default for local dev
#               and the test suite
#   alpaca      real HTTP adapter (Alpaca /v1/corporate-actions)
#   fmp         real HTTP adapter (Financial Modeling Prep dividends / splits)
# Selecting a real provider without its credentials FAILS STARTUP — there is no
# silent fallback to manual_dev. An unrecognized value also fails startup with
# "unsupported income provider: <value>".
#
# These integrations are for personal / local / internal use. Free-tier provider
# terms do not cover public commercial redistribution of their data.
DATA_USAGE_MODE=personal

# Alpaca market data. Do NOT commit real keys. The secret is never logged.
ALPACA_MARKET_DATA_ENABLED=false
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_REQUEST_TIMEOUT=10s

# Financial Modeling Prep. Requests stop once the daily budget is spent and the
# adapter reports an explicit budget-exhausted error (never "no data").
FMP_ENABLED=false
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_REQUEST_TIMEOUT=10s
FMP_DAILY_REQUEST_BUDGET=250

# --- Instrument identity (OpenFIGI) -------------------------------------------
# Stable instrument identity: an internal UUID plus time-scoped aliases, so a
# holding survives ticker changes (FB -> META), ticker reuse and cross-exchange
# symbol collisions. Resolution uses OpenFIGI's POST /v3/mapping endpoint.
#
# The API key is OPTIONAL — OpenFIGI permits unauthenticated low-volume use. It
# is sent in the X-OPENFIGI-APIKEY header and is never logged. Do NOT commit a
# real key. When OPENFIGI_ENABLED is false, resolution degrades to "unresolved"
# with no network call.
#
# STATUS: the identity layer is standalone. The buy path, income pipeline and
# corporate-action pipeline still key on the ticker string; wiring them up is a
# later slice.
OPENFIGI_ENABLED=false
OPENFIGI_API_KEY=
OPENFIGI_BASE_URL=https://api.openfigi.com
OPENFIGI_REQUEST_TIMEOUT=10s

# Sentry error reporting. Empty disables it entirely (no default/shared DSN).
# Reports panics recovered from HTTP handlers; background-worker failures
# still only go to structured logs (see docs/operations/alerting.md).
SENTRY_DSN=
